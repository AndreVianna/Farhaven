[resource]
script = ExtResource("1_biome")
id = &"B00003"
display_name = "Forest"
short_description = "Tall, thin trees that grew taller in the lower gravity."
long_description = "A canopy that climbs higher than feels right — these trees pushed for height where Earth's would have stalled, helped along by 0.8g and tidal warmth. Wood, sap, and shade all in supply. Visibility drops and sounds carry differently between the trunks."
color = Color(0.14901960784313725, 0.5019607843137255, 0.14901960784313725, 1.0)
natural_props = Array[Resource]([SubResource("biome_prop_1"), SubResource("biome_prop_2"), SubResource("biome_prop_3"), SubResource("biome_prop_4"), SubResource("biome_prop_5"), SubResource("biome_prop_6"), SubResource("biome_prop_7"), SubResource("biome_prop_8"), SubResource("biome_prop_9"), SubResource("biome_prop_10"), SubResource("biome_prop_11"), SubResource("biome_prop_12"), SubResource("biome_prop_13"), SubResource("biome_prop_14"), SubResource("biome_prop_15"), SubResource("biome_prop_16"), SubResource("biome_prop_17"), SubResource("biome_prop_18"), SubResource("biome_prop_19"), SubResource("biome_prop_20"), SubResource("biome_prop_21")])
terrain_textures = [ExtResource("2_tex1"), ExtResource("3_tex2"), ExtResource("4_tex3"), ExtResource("5_tex4")]
