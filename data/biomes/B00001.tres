[ext_resource type="Script" path="res://scripts/hex/biome_data.gd" id="1_biome"]

[resource]
script = ExtResource("1_biome")
id = &"B00001"
display_name = "Crash Site"
short_description = "The impact furrow where your escape pod came down."
long_description = "A small clearing torn open by your descent. Scrap from the pod, parachute fabric, ablative ceramic, and a charred furrow of broken branches mark the path you cut through the canopy. The air is still. Whatever lived here moved on when the sky cracked open."
color = Color(0.7490196078431373, 0.6196078431372549, 0.4196078431372549, 1.0)
