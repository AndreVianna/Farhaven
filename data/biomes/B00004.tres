[resource]
script = ExtResource("1_biome")
id = &"B00004"
display_name = "Rocky"
short_description = "Boulders, exposed ridges, and loose stone."
long_description = "Hard ground worn by tidal heating and old glacial weather. Stone and ore wait in the cracks of every ridge; movement is slower across the broken terrain, but the high ground sees far. Good place to stop and think."
color = Color(0.5490196078431373, 0.5019607843137255, 0.45098039215686275, 1.0)
terrain_textures = [ExtResource("2_tex1"), ExtResource("3_tex2"), ExtResource("4_tex3"), ExtResource("5_tex4")]
natural_props = Array[Resource]([SubResource("biome_prop_1"), SubResource("biome_prop_2"), SubResource("biome_prop_3"), SubResource("biome_prop_4"), SubResource("biome_prop_5"), SubResource("biome_prop_6"), SubResource("biome_prop_7"), SubResource("biome_prop_8"), SubResource("biome_prop_9"), SubResource("biome_prop_10"), SubResource("biome_prop_11"), SubResource("biome_prop_12"), SubResource("biome_prop_13"), SubResource("biome_prop_14")])
