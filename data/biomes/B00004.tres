[resource]
script = ExtResource("1_biome")
id = &"B00004"
display_name = "Rocky"
short_description = "Boulders, exposed ridges, and loose stone."
long_description = "Hard ground worn by tidal heating and old glacial weather. Stone and ore wait in the cracks of every ridge; movement is slower across the broken terrain, but the high ground sees far. Good place to stop and think."
