[resource]
script = ExtResource("1_biome")
id = &"B00010"
display_name = "Coastal Rocks"
short_description = "Wave-worn rock at the water's edge."
long_description = "Same hard ground as the inland ridges, but the tide and salt mist have given the surface a different character — pock-marks where shells settled, polished patches where currents linger, scatter from whatever the water leaves behind. The catalogue of life here is its own."
color = Color(0.5490196078431373, 0.5019607843137255, 0.45098039215686275, 1.0)
natural_props = Array[Resource]([SubResource("biome_prop_1"), SubResource("biome_prop_2")])
