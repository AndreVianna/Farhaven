[resource]
script = ExtResource("1_biome")
id = &"B00002"
display_name = "Grassland"
short_description = "Open plains of tall grass and low brush."
long_description = "Wide meadows broken by stands of fiber-rich grass. Easy to cross, easy to spot what is around you, easy to be spotted in turn. Small fauna graze here and watch from a careful distance."
color = Color(0.4, 0.7490196078431373, 0.30196078431372547, 1.0)
natural_props = Array[Resource]([SubResource("biome_prop_1"), SubResource("biome_prop_2"), SubResource("biome_prop_3"), SubResource("biome_prop_4"), SubResource("biome_prop_5"), SubResource("biome_prop_6"), SubResource("biome_prop_7"), SubResource("biome_prop_8"), SubResource("biome_prop_9"), SubResource("biome_prop_10"), SubResource("biome_prop_11")])
