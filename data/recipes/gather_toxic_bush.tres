[gd_resource type="Resource" script_class="Recipe" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/recipes/recipe.gd" id="1_recipe"]
[ext_resource type="Script" path="res://scripts/recipes/recipe_input.gd" id="2_input"]
[ext_resource type="Script" path="res://scripts/recipes/recipe_output.gd" id="3_output"]
[ext_resource type="Script" path="res://scripts/recipes/recipe_effect.gd" id="4_effect"]
[ext_resource type="Script" path="res://scripts/recipes/predicate.gd" id="5_predicate"]

[sub_resource type="Resource" id="input_1"]
script = ExtResource("2_input")
ref_or_tag = &"00008"
count = 1
source = &"world_tile"

[sub_resource type="Resource" id="output_1"]
script = ExtResource("3_output")
prop_ref = &"00021"
count = 2

[sub_resource type="Resource" id="effect_1"]
script = ExtResource("4_effect")
kind = &"sound"
params = { "sound_id": "gather" }

[sub_resource type="Resource" id="unlock_pred_1"]
script = ExtResource("5_predicate")
kind = &"cataloged"
params = { "prop": "toxic_berry_bush" }

[resource]
script = ExtResource("1_recipe")
id = &"gather_toxic_bush"
kind = 2
inputs = [SubResource("input_1")]
outputs = [SubResource("output_1")]
effects = [SubResource("effect_1")]
