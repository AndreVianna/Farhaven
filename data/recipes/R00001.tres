[gd_resource type="Resource" script_class="Recipe" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/recipes/recipe.gd" id="1_recipe"]
[ext_resource type="Script" path="res://scripts/recipes/recipe_input.gd" id="2_input"]
[ext_resource type="Script" path="res://scripts/recipes/recipe_effect.gd" id="3_effect"]

[sub_resource type="Resource" id="input_1"]
script = ExtResource("2_input")
ref = "P00020"
count = 1
must_hold = true

[sub_resource type="Resource" id="effect_1"]
script = ExtResource("3_effect")
kind = &"stat_delta"
params = { "stat": "hunger", "value": 5 }

[sub_resource type="Resource" id="effect_2"]
script = ExtResource("3_effect")
kind = &"sound"
params = { "sound_id": "crunch" }

[resource]
script = ExtResource("1_recipe")
id = &"R00001"
display_name = "Eat Berry"
inputs = [SubResource("input_1")]
effects = [SubResource("effect_1"), SubResource("effect_2")]
actions = [&"eat"]
