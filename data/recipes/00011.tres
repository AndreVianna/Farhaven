[gd_resource type="Resource" script_class="Recipe" load_steps=14 format=3]

[ext_resource type="Script" path="res://scripts/recipes/recipe.gd" id="1_recipe"]
[ext_resource type="Script" path="res://scripts/recipes/recipe_input.gd" id="2_input"]
[ext_resource type="Script" path="res://scripts/recipes/recipe_output.gd" id="3_output"]
[ext_resource type="Script" path="res://scripts/recipes/recipe_effect.gd" id="4_effect"]
[ext_resource type="Script" path="res://scripts/recipes/recipe_condition.gd" id="5_condition"]
[ext_resource type="Script" path="res://scripts/recipes/predicate.gd" id="6_predicate"]

[sub_resource type="Resource" id="input_1"]
script = ExtResource("2_input")
ref_or_tag = &"00022"
count = 1

[sub_resource type="Resource" id="output_1"]
script = ExtResource("3_output")
prop_ref = &"cooked_meat"
count = 1

[sub_resource type="Resource" id="effect_1"]
script = ExtResource("4_effect")
kind = &"sound"
params = { "sound_id": "sizzle" }

[sub_resource type="Resource" id="cond_pred_1"]
script = ExtResource("6_predicate")
kind = &"at_station"
params = { "tag": "cook" }

[sub_resource type="Resource" id="condition_1"]
script = ExtResource("5_condition")
predicate = SubResource("cond_pred_1")
must_sustain = true

[sub_resource type="Resource" id="cond_pred_2"]
script = ExtResource("6_predicate")
kind = &"prop_state"
params = { "prop": "00101", "field": "is_lit", "op": "eq", "value": true }

[sub_resource type="Resource" id="condition_2"]
script = ExtResource("5_condition")
predicate = SubResource("cond_pred_2")
must_sustain = true

[resource]
script = ExtResource("1_recipe")
id = &"00011"
display_name = "Cook Meat"
kind = 1
inputs = [SubResource("input_1")]
outputs = [SubResource("output_1")]
effects = [SubResource("effect_1")]
conditions = [SubResource("condition_1"), SubResource("condition_2")]
actions = [&"place_on_fire"]
duration = 15.0
