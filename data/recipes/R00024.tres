[gd_resource type="Resource" script_class="Recipe" load_steps=12 format=3]

[ext_resource type="Script" path="res://scripts/recipes/recipe.gd" id="1_recipe"]
[ext_resource type="Script" path="res://scripts/recipes/recipe_input.gd" id="2_input"]
[ext_resource type="Script" path="res://scripts/recipes/recipe_output.gd" id="3_output"]
[ext_resource type="Script" path="res://scripts/recipes/recipe_effect.gd" id="4_effect"]
[ext_resource type="Script" path="res://scripts/recipes/recipe_condition.gd" id="5_cond"]
[ext_resource type="Script" path="res://scripts/recipes/predicate.gd" id="6_pred"]

[sub_resource type="Resource" id="input_1"]
script = ExtResource("2_input")
ref = "P00010"
count = 3
must_hold = true

[sub_resource type="Resource" id="output_1"]
script = ExtResource("3_output")
prop_ref = &"P00106"
count = 1

[sub_resource type="Resource" id="effect_1"]
script = ExtResource("4_effect")
kind = &"sound"
params = { "sound_id": "craft_success" }

[sub_resource type="Resource" id="pred_buildable"]
script = ExtResource("6_pred")
kind = &"at_tile_type"
params = { "tag": "buildable" }

[sub_resource type="Resource" id="cond_buildable"]
script = ExtResource("5_cond")
predicate = SubResource("pred_buildable")
must_sustain = false

[resource]
script = ExtResource("1_recipe")
id = &"R00024"
display_name = "Build Wall"
inputs = [SubResource("input_1")]
outputs = [SubResource("output_1")]
effects = [SubResource("effect_1")]
conditions = [SubResource("cond_buildable")]
actions = [&"build"]
duration = 2.0
