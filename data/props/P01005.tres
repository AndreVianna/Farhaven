[gd_resource type="Resource" script_class="PropDef" load_steps=20 format=3]

[ext_resource type="Script" path="res://scripts/data/prop_def.gd" id="1_propdef"]
[ext_resource type="Script" path="res://scripts/data/capabilities/placeable_cap.gd" id="2_placeable"]
[ext_resource type="Script" path="res://scripts/data/capabilities/catalogable_cap.gd" id="3_catalogable"]
[ext_resource type="Script" path="res://scripts/data/capabilities/harvestable_cap.gd" id="4_harvestable"]
[ext_resource type="Script" path="res://scripts/data/capabilities/harvest_yield.gd" id="5_yield"]
[ext_resource type="Script" path="res://scripts/data/capabilities/mesh_variant.gd" id="6_meshvar"]
[ext_resource type="PackedScene" path="res://assets/props/P01005/mesh_v1.glb" id="7_mesh_v1"]
[ext_resource type="PackedScene" path="res://assets/props/P01005/mesh_v2.glb" id="8_mesh_v2"]
[ext_resource type="PackedScene" path="res://assets/props/P01005/mesh_v3.glb" id="9_mesh_v3"]
[ext_resource type="Script" path="res://scripts/data/capabilities/collision_shape.gd" id="10_collision"]
[ext_resource type="Script" path="res://scripts/data/capabilities/placement_cap.gd" id="11_placement"]

[sub_resource type="Resource" id="mesh_variant_1"]
script = ExtResource("6_meshvar")
scene = ExtResource("7_mesh_v1")
scale = 0.3
rotation_offset_deg = 0.0

[sub_resource type="Resource" id="mesh_variant_2"]
script = ExtResource("6_meshvar")
scene = ExtResource("8_mesh_v2")
scale = 0.3
rotation_offset_deg = 0.0

[sub_resource type="Resource" id="mesh_variant_3"]
script = ExtResource("6_meshvar")
scene = ExtResource("9_mesh_v3")
scale = 0.3
rotation_offset_deg = 0.0

[sub_resource type="Resource" id="collision_1"]
script = ExtResource("10_collision")
shape_type = &"box"
size = Vector3(0.25, 0.2, 0.25)
offset = Vector3(0.0, 0.1, 0.0)

[sub_resource type="Resource" id="placeable_1"]
script = ExtResource("2_placeable")
footprint = Vector2i(1, 1)
meshes = Array[Resource]([SubResource("mesh_variant_1"), SubResource("mesh_variant_2"), SubResource("mesh_variant_3")])
collision_shapes = Array[Resource]([SubResource("collision_1")])

[sub_resource type="Resource" id="catalogable_1"]
script = ExtResource("3_catalogable")
scan_time = 2.0
show_as_anomaly = false
properties = { "crystal_form": "irregular", "crystal_pattern": "cubic", "hardness": 4, "breaking_behavior": "bends", "surface_shine": "metallic", "light_transmission": "blocked", "fluorescence": false, "piezoelectricity": false, "radioactivity": false, "density": 7.9 }

[sub_resource type="Resource" id="yield_iron"]
script = ExtResource("5_yield")
item_id = &"iron_ore"
amount = 1
conditions = [&"tool:stone_breaking_tool"]

[sub_resource type="Resource" id="harvestable_1"]
script = ExtResource("4_harvestable")
yields = [SubResource("yield_iron")]
respawn_conditions = []

[sub_resource type="Resource" id="placement_1"]
script = ExtResource("11_placement")
placement = 3

[resource]
script = ExtResource("1_propdef")
id = &"P01005"
display_name = "Iron Nodule"
short_description = "A rust-hued metallic nodule."
long_description = "A heavy, rust-streaked mass of native iron-bearing ore. Dull metallic sheen where weather has worn the crust. Worth the effort of breaking."
category = &"mineral"
rarity = &"rare"
tags = [&"resource_source"]
placeable = SubResource("placeable_1")
catalogable = SubResource("catalogable_1")
harvestable = SubResource("harvestable_1")
placement = SubResource("placement_1")
