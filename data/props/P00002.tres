[resource]
script = ExtResource("1_propdef")
id = &"P00002"
display_name = "Tuft Moss"
short_description = "Soft cushions of water-rich moss-like growth."
long_description = "Spongy clumps that hold surprising amounts of moisture. Fragile but abundant in wetter patches of the plains. Faint bioluminescent veins pulse beneath translucent domes, dotted with small glowing spore pods."
category = &"plant"
rarity = &"common"
tags = [&"decoration"]
placeable = SubResource("placeable_1")
catalogable = SubResource("catalogable_1")
harvestable = SubResource("harvestable_1")
