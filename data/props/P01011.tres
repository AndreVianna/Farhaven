        [ext_resource type="Script" path="res://scripts/data/capabilities/mesh_variant.gd" id="3_mesh_variant"]
        [ext_resource type="PackedScene" path="res://assets/props/P01011/mesh_v1.glb" id="4_mesh_scene_1"]
        [ext_resource type="PackedScene" path="res://assets/props/P01011/mesh_v2.glb" id="5_mesh_scene_2"]
        [ext_resource type="PackedScene" path="res://assets/props/P01011/mesh_v3.glb" id="6_mesh_scene_3"]
        [ext_resource type="Script" path="res://scripts/data/capabilities/catalogable_cap.gd" id="8_catalogable"]
        [ext_resource type="Script" path="res://scripts/data/capabilities/harvestable_cap.gd" id="9_harvestable"]
        [ext_resource type="Script" path="res://scripts/data/capabilities/harvest_yield.gd" id="10_harvest_yield"]

        [sub_resource type="Resource" id="mesh_variant_1"]
        script = ExtResource("3_mesh_variant")
        scene = ExtResource("4_mesh_scene_1")
        scale = 0.3

        [sub_resource type="Resource" id="mesh_variant_2"]
        script = ExtResource("3_mesh_variant")
        scene = ExtResource("5_mesh_scene_2")
        scale = 0.3

        [sub_resource type="Resource" id="mesh_variant_3"]
        script = ExtResource("3_mesh_variant")
        scene = ExtResource("6_mesh_scene_3")
        scale = 0.3

        [sub_resource type="Resource" id="harvest_yield_1"]
        script = ExtResource("10_harvest_yield")
        item_id = &"raw_crystal"
        amount = 1
        conditions = [&"tool:stone_breaking_tool"]

        [sub_resource type="Resource" id="placeable_1"]
        script = ExtResource("2_placeable")
        meshes = Array[Resource]([SubResource("mesh_variant_1"), SubResource("mesh_variant_2"), SubResource("mesh_variant_3")])
        placement = 0
        slope_blend = 0.1
        max_allowed_slope = 15

        [sub_resource type="Resource" id="catalogable_1"]
script = ExtResource("8_catalogable")
scan_time = 2.0
properties = { &"hardness": 7, &"breaking_behavior": 'shatters', &"surface_shine": 'faceted', &"light_transmission": 'translucent', &"fluorescence": false, &"density": 2.6 }

        [sub_resource type="Resource" id="harvestable_1"]
        script = ExtResource("9_harvestable")
        yields = Array[HarvestYield]([SubResource("harvest_yield_1")])
        respawn_conditions = []

        [resource]
        script = ExtResource("1_script")
        id = &"P01011"
        display_name = "Quartz Spire"
        short_description = "A tall quartz crystal growing from a stone base."
        long_description = "A single elongated hexagonal quartz prism rising from the rock. Clean and faceted — the more common cousin of the cluster."
        category = &"mineral"
        rarity = &"common"
        tags = [&"resource_source"]
        placeable = SubResource("placeable_1")
        catalogable = SubResource("catalogable_1")
        harvestable = SubResource("harvestable_1")
        max_stack = 99
        origin = 0
