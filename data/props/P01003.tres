show_as_anomaly = false
properties = { "crystal_form": "formless", "crystal_pattern": "trigonal", "hardness": 7, "breaking_behavior": "shatters", "surface_shine": "waxy", "light_transmission": "diffused", "fluorescence": false, "piezoelectricity": true, "radioactivity": false, "density": 2.6 }

[sub_resource type="Resource" id="yield_flint"]
