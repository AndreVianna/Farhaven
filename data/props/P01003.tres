respawn_conditions = []

[resource]
script = ExtResource("1_propdef")
id = &"P01003"
display_name = "Flint Deposit"
short_description = "A seam of glassy flint in the soil."
long_description = "Dense, waxy-lustered mineral with a conchoidal fracture. Hard enough to scrape steel and sharp enough to cut flesh when struck correctly."
category = &"mineral"
rarity = &"common"
tags = [&"resource_source"]
placeable = SubResource("placeable_1")
catalogable = SubResource("catalogable_1")
harvestable = SubResource("harvestable_1")
