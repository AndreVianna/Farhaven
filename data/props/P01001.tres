meshes = Array[Resource]([SubResource("mesh_variant_1"), SubResource("mesh_variant_2"), SubResource("mesh_variant_3")])

[sub_resource type="Resource" id="catalogable_1"]
script = ExtResource("3_catalogable")
scan_time = 2.0
show_as_anomaly = false
properties = { "crystal_form": "irregular", "crystal_pattern": "none", "hardness": 6, "breaking_behavior": "shatters", "surface_shine": "dull", "light_transmission": "blocked", "fluorescence": false, "piezoelectricity": false, "radioactivity": false, "density": 2.7 }

[resource]
script = ExtResource("1_propdef")
id = &"P01001"
display_name = "Boulder"
short_description = "A large weathered boulder."
long_description = "A silent monolith of weathered stone, too massive to shift without heavy tools. Marks the landscape as much as the land itself."
category = &"mineral"
rarity = &"common"
tags = [&"decoration"]
placeable = SubResource("placeable_1")
catalogable = SubResource("catalogable_1")
placeholder_mesh_type = &"octahedron"
placeholder_params = {"half_size": 0.45}
placeholder_color = Color(0.4, 0.4, 0.4, 1.0)
