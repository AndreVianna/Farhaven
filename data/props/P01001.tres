[ext_resource type="PackedScene" path="res://assets/props/P01001/mesh_v2.glb" id="6_mesh_v2"]
[ext_resource type="PackedScene" path="res://assets/props/P01001/mesh_v3.glb" id="7_mesh_v3"]

[sub_resource type="Resource" id="mesh_variant_1"]
script = ExtResource("4_meshvar")
