[resource]
script = ExtResource("1_propdef")
id = &"P01004"
display_name = "Clay Patch"
short_description = "A smooth patch of workable clay."
long_description = "Damp, malleable clay exposed where water once pooled. Shapes easily in the hand, hardens when fired."
category = &"mineral"
rarity = &"common"
