[gd_resource type="Resource" script_class="CatalogData" load_steps=5 format=3 uid="uid://catalogminerals001"]

[ext_resource type="Script" path="res://scripts/scanner/catalog_data.gd" id="1_data"]
[ext_resource type="Script" path="res://scripts/scanner/catalog_entry.gd" id="2_entry"]

[sub_resource type="Resource" id="stone_deposit"]
script = ExtResource("2_entry")
entry_id = &"stone_deposit"
category = 2
display_name = "Stone Deposit"
description = "Common grey rock. Good for basic tools and construction."
properties = {"resource_type": &"stone", "tool_required": &""}

[sub_resource type="Resource" id="iron_deposit"]
script = ExtResource("2_entry")
entry_id = &"iron_deposit"
category = 2
display_name = "Iron Deposit"
description = "Rust-coloured ore embedded in rock. Needs a pickaxe to extract."
properties = {"resource_type": &"ore", "tool_required": &"stone_pickaxe"}

[sub_resource type="Resource" id="crystal_cluster"]
script = ExtResource("2_entry")
entry_id = &"crystal_cluster"
category = 2
display_name = "Crystal Cluster"
description = "Prismatic crystals that hum faintly. Their purpose is unknown."
properties = {"resource_type": &"crystal", "tool_required": &"stone_pickaxe"}

[resource]
script = ExtResource("1_data")
entries = [SubResource("stone_deposit"), SubResource("iron_deposit"), SubResource("crystal_cluster")]
